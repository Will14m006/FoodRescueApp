# ===== Food Rescue Backend — contoh konfigurasi =====
# Salin file ini menjadi `.env` lalu isi JWT_SECRET dengan nilai acak baru.
#   PowerShell:  Copy-Item .env.example .env
# JANGAN pernah meng-commit `.env`. Hanya file ini (.env.example) yang boleh
# masuk repository.
#
# Generate JWT_SECRET acak 64 byte:
#   dart run tool/gen_secret.dart
# atau tanpa Dart:
#   PowerShell:  [Convert]::ToBase64String((1..48 | % { Get-Random -Max 256 }))

# Port HTTP server. 8080 default, hindari 3000/5173 (sering dipakai dev lain).
PORT=8080

# Wajib: minimal 32 karakter. Server MENOLAK start kalau kosong, terlalu
# pendek, atau masih berisi placeholder dari file ini.
JWT_SECRET=ganti-dengan-hasil-gen_secret-dart

# Umur token JWT (menit). 60 menit cukup untuk demo; perpanjang hanya kalau
# sudah ada mekanisme refresh token.
JWT_TTL_MINUTES=60

# Path file SQLite. Relatif terhadap folder backend/.
DATABASE_FILE=data/food_rescue.db

# true hanya saat debugging lokal. Di produksi WAJIB false, karena `true`
# mengaktifkan log SQL yang bisa memuat data pribadi.
LOG_SQL=false
